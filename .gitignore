# Android Studio: настройки .idea Studio генерирует сама при синхронизации с Gradle или хранит
# в них личное (выбранное устройство, JDK). В git остаются только общие для команды
*.iml
/.idea/*
!/.idea/.gitignore
!/.idea/vcs.xml
!/.idea/inspectionProfiles/

